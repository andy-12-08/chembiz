# Copy this file to docker/.env and replace only the placeholder secrets.
# Never commit real credentials.

OPENAI_API_KEY=replace-with-openai-api-key
TAVILY_API_KEY=replace-with-tavily-api-key

POSTGRES_USER=chembiz
POSTGRES_PASSWORD=replace-with-local-database-password
POSTGRES_DB=chembiz
POSTGRES_PORT=5433

QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=chembiz_documents
QDRANT_PORT=6333

TEMPORAL_DB=postgres12
TEMPORAL_DB_HOST=temporal-postgresql
TEMPORAL_DB_PORT=5432
TEMPORAL_DB_USER=temporal
TEMPORAL_DB_PASSWORD=replace-with-local-temporal-password
TEMPORAL_DB_NAME=temporal
TEMPORAL_SERVER_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=chembiz
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8080
TEMPORAL_UI_CORS_ORIGINS=http://localhost:3000

LOG_LEVEL=INFO
